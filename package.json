{
  "name": "second-brain",
  "version": "2.0.0",
  "private": true,
  "description": "A private, local-first 3D map of your YouTube library. Import links or Google Takeout history; built for 100,000 videos.",
  "type": "module",
  "scripts": {
    "local": "node scripts/serve.mjs --open",
    "serve": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "screenshots": "node scripts/verify.mjs --shots",
    "benchmark:build": "node scripts/build-benchmark.mjs",
    "benchmark:verify": "node scripts/verify-benchmark.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
